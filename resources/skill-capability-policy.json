    "vercel@openai-curated": {
      "enabled": false,
      "reason": "The bundle contains broad browser and frontend helpers that cannot be disabled independently; use native work and official provider evidence."
    },
    "cloudinary@openai-curated": { "enabled": true, "activation": "explicit-cloudinary-or-current-provider-state" },
    "render@openai-curated": { "enabled": true, "activation": "explicit-render-or-current-provider-state" },
    "convex@openai-curated": { "enabled": true, "activation": "matching-convex-technology" },
    "openai-developers@openai-curated": { "enabled": true, "activation": "matching-openai-product-or-api" },
    "coderabbit@openai-curated": { "enabled": true, "activation": "explicit-coderabbit-or-current-review-state" },
    "computer-use@openai-bundled": { "enabled": true, "activation": "non-browser-windows-ui-or-authorized-fallback" },
    "chrome@openai-bundled": { "enabled": true, "activation": "existing-authenticated-chrome-session" },
    "visualize@openai-bundled": { "enabled": true, "activation": "explicit-conversation-visualization" },
    "documents@openai-primary-runtime": { "enabled": true, "activation": "document-file-task" },
    "pdf@openai-primary-runtime": { "enabled": true, "activation": "pdf-file-task" },
    "spreadsheets@openai-primary-runtime": { "enabled": true, "activation": "spreadsheet-file-task" },
    "presentations@openai-primary-runtime": { "enabled": true, "activation": "presentation-file-task" },
    "template-creator@openai-primary-runtime": { "enabled": true, "activation": "explicit-reusable-template-task" },
    "browser@openai-bundled": { "enabled": true, "activation": "primary-rendered-site-evidence" },
    "product-design@openai-curated": { "enabled": true, "activation": "explicit-product-design-audit-clone-or-visual-exploration", "managedByConfig": false }
  },
