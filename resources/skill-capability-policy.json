    "cloudflare@openai-curated": { "enabled": true, "activation": "explicit-cloudflare-or-current-provider-state" },
    "sites@openai-bundled": {
      "enabled": false,
      "reason": "Broad website trigger conflicts with D:\\Work direct/full-pipeline routing."
    },
    "superpowers@superpowers-adaptive-lite": {
      "enabled": false,
      "reason": "Generic planning, debugging and verification duplicate native runtime behavior."
    },
    "build-web-apps@openai-curated": {
      "enabled": false,
      "reason": "Broad hero, redesign, frontend and browser-testing triggers conflict with native work and D:\\Work routing."
