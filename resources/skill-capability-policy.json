{
  "schemaVersion": 4,
  "targetModels": [
    "gpt-5.6-sol",
    "claude-fable-5",
    "claude-sonnet-5"
  ],
  "layers": {
    "nativeModel": "Reasoning, planning, architecture, code and content work from supplied context.",
    "nativeRuntime": "Repository inspection, edits, commands, tests, builds and visual checks.",
    "localSkill": "D:\\Work policy, phase ownership, evidence artifacts and non-obvious failure patterns.",
    "externalTool": "Current or external state such as live sites, accounts, deployment and monitoring."
  },
  "routeModes": {
    "direct": "Focused change or simple static site; no pipeline status file.",
    "full-pipeline": "Complex new site using contract v2 and artifact-backed resume."
  },
  "designCapability": {
    "nativeOwner": [
      "brief-inference",
      "design-direction",
      "composition-and-typography",
      "ux-and-accessibility-reasoning",
      "frontend-code",
      "static-review"
    ],
    "localArtifactOwner": {
      "skill": "site-design",
      "artifact": "DESIGN-DIRECTION.md",
      "activation": ["full-pipeline", "explicit"],
      "explicitMeaning": "The user explicitly asks to create or record a design direction/artifact; routeMode may remain direct."
    },
    "preferencePrecedence": [
      "project-brief",
      "brand-and-accessibility",
      "local-user-preferences",
      "wiki-defaults"
    ],
    "externalToolConditions": {
      "reference-search": "Required for current visual evidence, competitor surfaces, font licenses or availability claims.",
      "browser": "Rendered desktop/mobile behavior and visual acceptance.",
      "figma": "Explicit Figma source or requested Figma deliverable.",
      "image-generation": "A requested image asset or visual reference cannot be derived from supplied assets."
    },
    "gateVocabulary": {
      "brand": "Preserve supplied brand constraints and incumbent visual truth.",
      "responsive": "Define and verify relevant desktop/mobile behavior.",
      "accessibility": "Keep contrast, keyboard, focus and reduced-motion requirements applicable to the surface.",
      "real-data": "Do not fabricate cases, metrics, testimonials, identities or product evidence.",
      "cyrillic-license": "Verify Cyrillic coverage, commercial license and self-host plan when Russian typography is selected.",
      "states": "Cover behavior states that exist on the implemented surface.",
      "evidence": "Distinguish supplied context from current externally verified facts.",
      "browser-evidence": "Use a rendered browser result for factual visual acceptance."
    },
    "externalToolTiming": "Mark an external tool only when the current requested outcome depends on external/current state; do not mark one solely for a possible later implementation choice.",
    "verification": "Inspect desktop and mobile in one bounded batch, fix supported findings, then confirm; expand only when risk or evidence requires it."
  },
  "motionMediaCapability": {
    "nativeOwner": [
      "motion-direction",
      "interaction-design",
      "animation-code",
      "static-motion-review"
    ],
    "interactionTiers": {
      "base": "CSS, Web Animations API and View Transitions; Motion only for justified React/Astro gestures, layout or reactive scroll.",
      "cinematic": "GSAP ScrollTrigger only for an explicit pinned, scrubbed or snapped multi-scene narrative after a current license check.",
      "specialized": "Rive requires a .riv asset and state/data-binding contract; Three.js requires a real 3D scene or model and a static fallback."
    },
    "routeOwnership": {
      "direct": {
        "owner": "native-model",
        "statusFile": false,
        "briefContract": "hero-media-brief.json"
      },
      "full-pipeline": {
        "designOwner": "site-design",
        "integrationOwner": "site-frontend",
        "verificationOwner": "site-review",
        "briefContract": "hero-media-brief.json"
      }
    },
    "artifactOwners": {
      "hero-media-package": {
        "owner": "D:\\kontent",
        "interface": "py content_agent.py web-hero --brief <file> --output <directory>",
        "manifest": "media-manifest.json"
      },
      "rendered-browser-evidence": {
        "owner": "site-review",
        "requiresTool": true
      }
    },
    "mediaModes": {
      "decorative": "Muted autoplay loop with poster, pause, reduced-motion/save-data fallback and no audio track.",
      "meaningful": "User-initiated controls with captions and transcript; no unmuted autoplay.",
      "synchronized": "requestVideoFrameCallback only when DOM or canvas must follow presented video frames."
    },
    "providerPolicy": {
      "default": "remotion-ffmpeg-local",
      "sora": {
        "status": "deprecated",
        "shutsDownAt": "2026-09-24",
        "activation": "explicit-paid-approval-and-current-provider-snapshot",
        "replacementRequired": true
      }
    },
    "globalSkill": false
  },
  "externalSkillDecisions": {
    "impeccable": {
      "decision": "extract-only",
      "hooks": false,
      "installed": false,
      "reason": "Broad trigger, duplicate design/review commands and low additive value in the local detector pilot."
    },
    "taste-skill": {
      "decision": "extract-only",
      "hooks": false,
      "installed": false,
      "reason": "Experimental broad prompt with forced style, motion and layout defaults that overlap native models."
    }
  },
  "providerSpecificSkills": {
    "codex": {
      "pluginManaged": [
        "product-design:index",
        "figma:figma-use"
      ],
      "activation": "Explicit product-design or Figma intent. React, shadcn and general frontend work remain native."
    },
    "claude": {
      "direct": ["vercel-react-best-practices"],
      "nativeFallback": ["shadcn-ui"],
      "activation": "React reference only for a concrete React/Next.js task; shadcn remains native unless explicitly requested."
    }
  },
  "toolRouting": {
    "browser-hierarchy": [
      {
        "owner": "specialized-connector-or-api",
        "when": "The outcome requires current external data or a provider action better represented by its API."
      },
      {
        "owner": "browser@openai-bundled",
        "when": "Primary rendered-site inspection, interaction and desktop/mobile visual evidence."
      },
      {
        "owner": "chrome@openai-bundled",
        "when": "The task explicitly requires an existing authenticated user Chrome session."
      },
      {
        "owner": "playwright",
        "tool": "playwright MCP or project-local Playwright",
        "when": "A reproducible isolated browser test or terminal automation artifact is required."
      },
      {
        "owner": "computer-use@openai-bundled",
        "when": "A non-browser Windows application is required, or the preferred scoped tool is unavailable and fallback is authorized."
      }
    ],
    "planning": {
      "owner": "native-model",
      "taskmaster": "disabled-generic-duplicate"
    },
    "current-documentation": {
      "owner": "official-source-via-web-or-context7",
      "activation": "Only when the task depends on current library or platform behavior."
    }
  },
  "forbiddenMcpServers": ["taskmaster-ai"],
  "phaseInputAliases": {
    "site-design": ["дизайн-направление", "design direction"],
    "site-handoff": ["handoff план", "handoff plan", "release/handoff"]
  },
